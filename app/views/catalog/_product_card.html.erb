<%= link_to product_path(product, **query.compact_blank.symbolize_keys), class: "product-card", data: { turbo_frame: "product_modal" } do %>
  <div class="product-card__image-wrap">
    <% if product.on_sale? %>
      <span class="sale-badge">SALE</span>
    <% end %>
    <% if product.image.attached? %>
      <%= active_storage_image_tag product.image, resize_to_limit: [ 400, 400 ], alt: product.name, loading: "lazy" %>
    <% else %>
      <%= image_tag "https://placehold.co/400x400/ddd/333?text=#{CGI.escape(product.name)}", alt: product.name %>
    <% end %>
    <div class="product-card__sizes">
      <% product.sizes.each do |sz| %>
        <span><%= sz %></span>
      <% end %>
    </div>
  </div>
  <div class="product-card__body">
    <h2 class="product-card__title"><%= product.name %></h2>
    <div>
      <% if product.on_sale? %>
        <span class="price-old"><%= format("%.0f", product.compare_at_price) %> ₽</span>
      <% end %>
      <span class="product-card__price"><%= product.display_price %> ₽</span>
    </div>
  </div>
<% end %>
